# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-me-to-a-random-32-character-string

# Database
DATABASE_URL=sqlite:///membership.db

# Email Configuration (Gmail example)
MAIL_BACKEND=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@membership.local

# Organization Settings
ORG_NAME=Membership Organization
ORG_EMAIL=admin@membership.local
ORG_PHONE=+234-XXX-XXXX-XXXX
ORG_ADDRESS=Your Organization Address

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=5

# Session Settings
SESSION_EXPIRY_HOURS=12
SESSION_TOKEN_LENGTH=32

# App Settings
ITEMS_PER_PAGE=20
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Logging
LOG_LEVEL=INFO
